{
	"name": "df_DataFromADLStoAzureDatabase",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SourceTransactionCSVDataFromADLS2",
						"type": "DatasetReference"
					},
					"name": "sourcedatafromadls"
				}
			],
			"sinks": [
				{
					"name": "sinkAzureSQLDatabase"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          TransactionID as string,",
				"          CustomerID as string,",
				"          ProductID as string,",
				"          Quantity as string,",
				"          UnitPrice as string,",
				"          Discount as string,",
				"          TransactionDate as string,",
				"          Hour as string,",
				"          StoreID as string,",
				"          PaymentMethod as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false,",
				"     enableCdc: true,",
				"     mode: 'read',",
				"     skipInitialLoad: false) ~> sourcedatafromadls",
				"sourcedatafromadls sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkAzureSQLDatabase"
			]
		}
	}
}
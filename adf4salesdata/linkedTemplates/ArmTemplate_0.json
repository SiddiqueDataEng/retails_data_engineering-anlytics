{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf4salesdata"
		},
		"AzureDataLakeStorage_sink_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage_sink'"
		},
		"LS_AzureSqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSqlDatabase'"
		},
		"LS_SqlServerOnPrem_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SqlServerOnPrem'"
		},
		"fs_localdatafolders_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'fs_localdatafolders'"
		},
		"AzureDataLakeStorage_sink_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adls4salesdata.dfs.core.windows.net/"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver4salesdata.database.windows.net"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb4salesdata"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Siddique"
		},
		"LS_SqlServerOnPrem_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-A3PO7VB\\SQLEXPRESS"
		},
		"LS_SqlServerOnPrem_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AbbasiCashandCarry"
		},
		"LS_SqlServerOnPrem_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"fs_localdatafolders_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\Users\\DataEng\\Desktop\\DataTeam (SQL+Python)\\Project\\sourcedata"
		},
		"fs_localdatafolders_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "DataEng"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
